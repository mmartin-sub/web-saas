{
  "version": "0.2",
  "ignorePaths": [
    "node_modules/**",
    "*.toml",
    "**/*.json"
  ],
  "dictionaryDefinitions": [],
  "dictionaries": [],
  "words": [
    "bunx",
    "Contentlayer",
    "focusable",
    "Lucide",
    "neondatabase",
    "nodemailer",
    "shadcn",
    "tanstack",
    "typesafe",
    "vercel",
    "Zustand"
  ],
  "ignoreWords": [
    "Altiste",
    "FADP",
    "kysely",
    "neon",
    "nextjs",
    "prisma",
    "saasfly",
    "substantifik",
    "trpc"
  ],
  "import": [],
  "enabled": true,
  "maxNumberOfProblems": 1,
  "useGitignore": true,
  "usePnP": true,
  "patterns": [
    {
      "name": "comment-single-line",
      "pattern": "/#.*/g"
    },
    {
      "name": "comment-multi-line",
      "pattern": "/(?:\\/\\*[\\s\\S]*?\\*\\/)/g"
    }
  ],
  "ignoreRegExpList": [
    "/from\\s+(['\"]).*\\1/",
    "^\\$.+",
    "\\$\\w+"
  ]
}
